  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:package": "publint --strict && attw --pack .",
    "size": "size-limit",
    "verify": "npm run lint && npm run typecheck && npm run test:coverage && npm run build && node scripts/check-dist.js && npm run lint:package && npm run types:consumer && npm run size",
    "changeset": "changeset",
    "release": "npm run verify && changeset publish",
    "docs:install": "npm ci --prefix docs",
    "docs:dev": "npm run build && npm run dev --prefix docs",
    "docs:build": "npm run build && npm run build --prefix docs",
    "test:coverage": "vitest run --coverage --exclude \"**/*.property.test.ts\" && npm run test:property",
    "test:property": "vitest run property.test",
    "types:consumer": "tsc -p consumer/tsconfig.bundler.json && tsc -p consumer/tsconfig.nodenext.json",
    "test:e2e": "playwright test"
  },
  "size-limit": [
