{
  "name": "react-smart-copy",
  "version": "0.1.0",
  "description": "Headless, type-safe copy interactions for React: text, rich HTML and images, with honest error states, retry, hover/focus/touch reveal and screen-reader announcements.",
  "keywords": [
    "react",
    "clipboard",
    "copy",
    "copy-to-clipboard",
    "headless",
    "accessibility",
    "a11y",
    "typescript",
    "hooks"
  ],
  "license": "MIT",
  "author": "Shubh",
  "homepage": "https://suprabhat02.github.io/react-smart-copy/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suprabhat02/react-smart-copy.git"
  },
  "bugs": {
    "url": "https://github.com/suprabhat02/react-smart-copy/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "core": [
        "./dist/core.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:package": "publint --strict && attw --pack .",
    "size": "size-limit",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run lint:package && npm run size",
    "changeset": "changeset",
    "release": "npm run verify && changeset publish",
    "site:build": "npm run build && node -e \"require('fs').copyFileSync('dist/core.js','site/core.js')\"",
    "site:preview": "npm run site:build && npx --yes serve site"
  },
  "size-limit": [
    {
      "name": "useCopy (text only)",
      "path": "dist/index.js",
      "import": "{ useCopy }",
      "limit": "3 kB"
    },
    {
      "name": "CopyField (everything React)",
      "path": "dist/index.js",
      "import": "{ CopyField }",
      "limit": "5 kB"
    },
    {
      "name": "core, all exports (framework-agnostic)",
      "path": "dist/core.js",
      "limit": "3.25 kB"
    }
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@size-limit/preset-small-lib": "^14.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.1",
    "publint": "^0.3.24",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "size-limit": "^14.0.0",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
