{
  // Type-checks the library and its tests against React 18's types from compat/react18.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "paths": {
      "react": ["./compat/react18/node_modules/@types/react"],
      "react/*": ["./compat/react18/node_modules/@types/react/*"],
      "react-dom": ["./compat/react18/node_modules/@types/react-dom"],
      "react-dom/*": ["./compat/react18/node_modules/@types/react-dom/*"],
      // As in tsconfig.json (a tsconfig that sets paths replaces them all).
      "react-smart-copy": ["./src/index.ts"],
      "react-smart-copy/*": ["./src/*/index.ts"]
    }
  }
}
