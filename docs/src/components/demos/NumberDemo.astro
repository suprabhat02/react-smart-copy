---
// The number demo: parseNumber, pasteAsNumber and formatNumber on amounts in several locales,
// wired up by numberDemo in ./demos.js on the built library.
import '../../styles/demos.css';
import markup from './markup/number.html?raw';

interface Props {
  /** The accessible name of the demo region. */
  label?: string;
}

const { label = 'Live demo' } = Astro.props;
---

<section class="rsc-demo not-content" aria-label={label}>
  <div class="panel" data-demo="number">
    <Fragment set:html={markup} />
  </div>
</section>

<script>
  import { numberDemo } from './demos.js';
  import { highlightAll } from './lib.js';

  highlightAll();
  numberDemo();
</script>
