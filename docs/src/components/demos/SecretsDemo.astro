---
// The secrets demo: scanSecrets, pasteWithoutSecrets and secretRedactor on fake secrets made in
// the browser, wired up by secretsDemo in ./demos.js on the built library.
import '../../styles/demos.css';
import markup from './markup/secrets.html?raw';

interface Props {
  /** The accessible name of the demo region. */
  label?: string;
}

const { label = 'Live demo' } = Astro.props;
---

<section class="rsc-demo not-content" aria-label={label}>
  <div class="panel" data-demo="secrets">
    <Fragment set:html={markup} />
  </div>
</section>

<script>
  import { secretsDemo } from './demos.js';
  import { highlightAll } from './lib.js';

  highlightAll();
  secretsDemo();
</script>
