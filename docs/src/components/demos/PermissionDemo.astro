---
// The clipboard permission demo: watchClipboardPermission for reading and writing, wired up by
// permissionDemo in ./demos.js on the built library.
import '../../styles/demos.css';
import markup from './markup/permission.html?raw';

interface Props {
  /** The accessible name of the demo region. */
  label?: string;
}

const { label = 'Live demo' } = Astro.props;
---

<section class="rsc-demo not-content" aria-label={label}>
  <div class="panel" data-demo="permission">
    <Fragment set:html={markup} />
  </div>
</section>

<script>
  import { permissionDemo } from './demos.js';
  import { highlightAll } from './lib.js';

  highlightAll();
  permissionDemo();
</script>
