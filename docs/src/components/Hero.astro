---
// Starlight's hero, with the live copy demo in place of an image on the landing page.
import DraftContentNotice from 'virtual:starlight/components/DraftContentNotice';
import { LinkButton } from '@astrojs/starlight/components';
import HeroDemo from './demos/HeroDemo.astro';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero ?? {};
const { id } = Astro.locals.starlightRoute;
const isLanding = id === '';
// The 404 entry is a draft only to keep it off the docs route: it is not unfinished.
const showDraftNotice = data.draft && id !== '404';
---

<div class:list={['hero', { 'has-demo': isLanding }]}>
  <div class="sl-flex stack">
    <div class="sl-flex copy">
      <h1 id="_top" data-page-title set:html={title} />
      {showDraftNotice && <DraftContentNotice />}
      {tagline && <div class="tagline" set:html={tagline} />}
    </div>
    {
      actions.length > 0 && (
        <div class="sl-flex actions">
          {actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
            <LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
              {text}
              {icon?.html && <Fragment set:html={icon.html} />}
            </LinkButton>
          ))}
        </div>
      )
    }
  </div>
  {isLanding && <div class="demo"><HeroDemo /></div>}
</div>

{
  isLanding && (
    <script is:inline>
      // The docs used to be one page: send its old anchors to the pages that replaced them.
      (() => {
        const page = (path, hash = '') => `/react-smart-copy/${path}/${hash}`;
        const demo = (path) => page(path, '#try-it');
        const moved = {
          'try-copy': demo('copy/use-copy'), playground: demo('copy/use-copy'),
          'try-paste': demo('paste/use-paste'), paste: demo('paste/use-paste'),
          'try-paste-field': demo('paste/paste-field'), 'paste-field': demo('paste/paste-field'),
          'try-group': demo('copy/copy-field'), 'copy-group': demo('copy/copy-field'),
          'try-capture': demo('copy/capture'), capture: demo('copy/capture'),
          'try-intercept': demo('copy/native-copy'), 'try-drag': demo('copy/drag-to-copy'),
          'try-tables': demo('modules/tables'), 'try-structured': demo('modules/structured'),
          'try-markdown': demo('modules/markdown'), 'try-code': demo('modules/code'),
          'try-images': demo('modules/images'), 'try-links': demo('modules/links'),
          'try-colors': demo('modules/colors'), 'try-rich': demo('modules/rich-text'),
          'quick-start': page('start/quick-start'), 'no-flicker': page('start/quick-start', '#no-flicker'),
          'what-it-copies': page('start/introduction', '#what-it-can-and-cannot-copy'),
          support: page('start/browser-support'),
          pasting: page('paste/use-paste'), pastefield: page('paste/paste-field'),
          retry: page('copy/use-copy'), groups: page('copy/copy-field'), api: page('copy/copy-field'),
          payloads: page('copy/payloads'), capturing: page('copy/capture'),
          'native-copy': page('copy/native-copy'), 'drag-copy': page('copy/drag-to-copy'),
          tables: page('modules/tables'), structured: page('modules/structured'),
          markdown: page('modules/markdown'), code: page('modules/code'), images: page('modules/images'),
          links: page('modules/links'), rich: page('modules/rich-text'), colors: page('modules/colors'),
          share: page('modules/share'), errors: page('reference/errors'),
          accessibility: page('guides/accessibility'), ssr: page('guides/ssr'),
          releases: page('project/releases'),
        };
        const go = () => {
          const target = moved[decodeURIComponent(location.hash.slice(1))];
          if (target) location.replace(target);
        };
        go();
        addEventListener('hashchange', go);
      })();
    </script>
  )
}

<style>
  @layer starlight.core {
    .hero {
      display: grid;
      grid-template-columns: 100%;
      align-items: center;
      gap: 2.5rem;
      padding-bottom: 1rem;
    }
    .stack {
      flex-direction: column;
      gap: clamp(1.5rem, calc(1.5rem + 1vw), 2rem);
      text-align: center;
    }
    .copy {
      flex-direction: column;
      gap: 1rem;
      align-items: center;
    }
    .copy > * {
      max-width: 50ch;
    }
    h1 {
      font-size: clamp(var(--sl-text-3xl), calc(0.25rem + 5vw), var(--sl-text-6xl));
      line-height: var(--sl-line-height-headings);
      font-weight: 650;
      color: var(--sl-color-white);
    }
    .tagline {
      font-size: clamp(var(--sl-text-base), calc(0.0625rem + 2vw), var(--sl-text-xl));
      color: var(--sl-color-gray-2);
    }
    .actions {
      gap: 1rem 2rem;
      flex-wrap: wrap;
      justify-content: center;
    }
    .demo {
      min-width: 0;
    }
    @media (min-width: 50rem) {
      .hero {
        padding-block: clamp(2.5rem, calc(1rem + 10vmin), 8rem);
      }
      .hero.has-demo {
        grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
        gap: 4%;
      }
      .stack {
        text-align: start;
      }
      .copy {
        align-items: flex-start;
      }
      .actions {
        justify-content: flex-start;
      }
    }
  }
</style>
