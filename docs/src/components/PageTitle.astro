---
// Starlight's page title, with a button that copies the page as Markdown: to paste into a chat,
// an issue or an editor. It is built from the library's own Markdown converter.
import Default from '@astrojs/starlight/components/PageTitle.astro';
---

<Default />
<div class="copy-page not-content" data-copy-page>
  <button type="button" data-copy-page-button>Copy page as Markdown</button>
  <span class="sr-only" role="status" data-copy-page-status></span>
</div>

<script>
  import { createCopyMachine, describeCopyError } from 'react-smart-copy/core';
  import { escapeMarkdown, htmlToMarkdown } from 'react-smart-copy/markdown';

  const LABEL = 'Copy page as Markdown';

  for (const root of document.querySelectorAll<HTMLElement>('[data-copy-page]')) {
    const button = root.querySelector<HTMLButtonElement>('[data-copy-page-button]');
    const status = root.querySelector<HTMLElement>('[data-copy-page-status]');
    const content = document.querySelector('.sl-markdown-content');
    if (button === null || status === null || content === null) continue;
    const machine = createCopyMachine();
    let timer: ReturnType<typeof setTimeout> | undefined;

    button.addEventListener('click', async () => {
      const outcome = await machine.copy(() => {
        // Converted during the click, so Safari still counts it as the user's action.
        const title = document.querySelector('h1')?.textContent?.trim() ?? document.title;
        // Leave out the live demos. Not `.not-content`: Starlight puts that class on code blocks too.
        // Heading permalinks are left out by the converter itself.
        const { markdown } = htmlToMarkdown(content, { ignore: '.rsc-demo', baseUrl: location.href });
        return `# ${escapeMarkdown(title)}\n\n${markdown}\n`;
      });
      if (outcome.status === 'ignored') return;
      const message = outcome.status === 'copied' ? 'Page copied as Markdown' : describeCopyError(outcome.error);
      button.textContent = outcome.status === 'copied' ? 'Copied' : 'Copy failed';
      status.textContent = message;
      clearTimeout(timer);
      timer = setTimeout(() => {
        button.textContent = LABEL;
        status.textContent = '';
      }, 2000);
    });
  }
</script>

<style>
  .copy-page {
    margin-top: 0.75rem;
  }
  .copy-page button {
    font: inherit;
    font-size: var(--sl-text-sm);
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    background: transparent;
    color: var(--sl-color-gray-2);
    cursor: pointer;
  }
  .copy-page button:hover {
    border-color: var(--sl-color-gray-3);
    color: var(--sl-color-white);
  }
  .copy-page button:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
</style>
